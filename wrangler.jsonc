{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hazem-portfolio",
  "main": "./worker.js",
  "compatibility_date": "2026-10-04",
  "send_metrics": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/contact/submit"
    ]
  }
}
